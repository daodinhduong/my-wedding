generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WeddingResponse {
  id               BigInt   @id @default(autoincrement())
  guestName        String   @map("guest_name")
  wishMessage      String?  @map("wish_message")
  attendanceStatus String   @default("pending") @map("attendance_status")
  guestCount       Int      @default(0) @map("guest_count")
  isApproved       Boolean  @default(false) @map("is_approved")
  responseSource   String   @default("website") @map("response_source")
  invitationSide   String?  @map("invitation_side")
  phone            String?
  note             String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitationId     String?  @unique @map("invitation_id")
  invitation       Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)], map: "wedding_responses_created_at_idx")
  @@index([attendanceStatus], map: "wedding_responses_attendance_status_idx")
  @@index([isApproved, createdAt(sort: Desc)], map: "wedding_responses_is_approved_idx")
  @@index([responseSource], map: "wedding_responses_response_source_idx")
  @@index([invitationSide], map: "wedding_responses_invitation_side_idx")
  @@map("wedding_responses")
}

model GalleryImage {
  key       String  @id
  position  Int
  isVisible Boolean @default(true) @map("is_visible")

  @@map("gallery_images")
}

model Invitation {
  id             String   @id @default(uuid())
  senderName     String   @map("sender_name")
  guestName      String   @map("guest_name")
  note           String?
  isSent         Boolean  @default(false) @map("is_sent")
  deliveryType   String   @default("online") @map("delivery_type")
  invitationSide String   @default("nha-trai") @map("invitation_side")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  response       WeddingResponse?

  @@index([createdAt(sort: Desc)])
  @@map("invitations")
}
